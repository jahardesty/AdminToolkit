<Page x:Class="AdminToolkit.Pages.RemoteCLIPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Remote CLI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top connection bar -->
        <Border Grid.Row="0"
                Background="#F4F5F7"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Target Computer:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="0,0,8,0"/>

                <TextBox x:Name="TargetComputerBox"
                         Grid.Column="1"
                         Text="localhost"
                         Padding="6,4"
                         VerticalContentAlignment="Center"/>

                <Button x:Name="ConnectButton"
                        Grid.Column="2"
                        Content="Connect"
                        Click="ConnectButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="8,0,0,0"/>

                <Button x:Name="DisconnectButton"
                        Grid.Column="3"
                        Content="Disconnect"
                        Click="DisconnectButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="False"
                        Margin="8,0,0,0"/>

                <RadioButton x:Name="PowerShellMode"
                             Grid.Column="4"
                             Content="PowerShell"
                             IsChecked="True"
                             Checked="PowerShellMode_Checked"
                             VerticalAlignment="Center"
                             Margin="18,0,10,0"/>

                <RadioButton x:Name="CmdMode"
                             Grid.Column="5"
                             Content="CMD"
                             Checked="CmdMode_Checked"
                             VerticalAlignment="Center"/>

                <StackPanel Grid.Column="6"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">

                    <Ellipse x:Name="StatusIndicator"
                             Width="9"
                             Height="9"
                             Fill="#A0A0A0"
                             Margin="0,0,6,0"/>

                    <TextBlock x:Name="StatusText"
                               Text="Disconnected"
                               Foreground="#666666"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Terminal output -->
        <Border Grid.Row="1"
                Background="#0C1021"
                CornerRadius="6"
                BorderBrush="#1E2538"
                BorderThickness="1"
                Padding="8">

            <RichTextBox x:Name="TerminalBox"
                         IsReadOnly="True"
                         Background="Transparent"
                         Foreground="#F8F8F2"
                         FontFamily="Consolas"
                         FontSize="13"
                         BorderThickness="0"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto">

                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin"
                                Value="0,1,0,1"/>
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>
        </Border>

        <!-- Command input -->
        <Grid Grid.Row="2"
              Margin="0,12,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="PromptLabel"
                       Grid.Column="0"
                       Text="PS >"
                       FontFamily="Consolas"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="#007ACC"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <TextBox x:Name="CommandInput"
                     Grid.Column="1"
                     Padding="8,6"
                     FontFamily="Consolas"
                     FontSize="13"
                     IsEnabled="False"
                     KeyDown="CommandInput_KeyDown"/>

            <Button x:Name="SendButton"
                    Grid.Column="2"
                    Content="Execute"
                    IsEnabled="False"
                    Click="SendButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="8,0,0,0"/>

            <Button x:Name="CancelButton"
                    Grid.Column="3"
                    Content="Stop"
                    IsEnabled="False"
                    Click="CancelButton_Click"
                    Style="{StaticResource DangerButtonStyle}"
                    Margin="8,0,0,0"/>
        </Grid>
    </Grid>
</Page>