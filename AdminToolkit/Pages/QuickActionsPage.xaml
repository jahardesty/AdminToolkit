<Page x:Class="AdminToolkit.Pages.QuickActionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource PageBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Quick Actions Console" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <WrapPanel Grid.Row="1" Orientation="Horizontal">
            <Button x:Name="btnTestConnections" 
        Content="🌐 Test DC Connections" 
        Width="180" Height="60" 
        Margin="10"
        Background="#4CAF50" Foreground="White"
        Click="TestConnections_Click"/>
            <Button x:Name="btnFlushDNS" 
                    Content="⚡ Flush Remote DNS" 
                    Width="180" Height="60" 
                    Margin="10"
                    Background="#007ACC" Foreground="White"
                    Click="FlushDNS_Click"/>

            <Button Content="🔄 Entra Sync" 
                    Width="180" Height="60" 
                    Margin="10"
                    Background="#007ACC" Foreground="White"
                    Click="EntraSync_Click"/>
        </WrapPanel>

        <TextBox x:Name="txtLog" Grid.Row="2" IsReadOnly="True" 
                 VerticalScrollBarVisibility="Auto" Background="#F3F3F3" 
                 FontFamily="Consolas" Padding="10"/>
    </Grid>
</Page>
